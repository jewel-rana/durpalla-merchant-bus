# Durpalla storefront API (durpalla-apigw). Server-side only; the browser never calls the API directly.
# dev: https://dev-apigw.durpalla.com   production: https://apigw.durpalla.com
API_BASE_URL=https://dev-apigw.durpalla.com
# Optional alias read when API_BASE_URL is unset.
NEXT_PUBLIC_API_BASE_URL=

# Tenant (merchant username) used on localhost / when the host cannot be resolved.
NEXT_PUBLIC_TENANT=greenline

# Default tenant domain: {tenant}.STOREFRONT_BASE_DOMAIN is resolved without an API call.
STOREFRONT_BASE_DOMAIN=durpalla.site

# Optional publishable key (pk_...) sent as X-Storefront-Key for per-client rate limiting.
STOREFRONT_KEY=
